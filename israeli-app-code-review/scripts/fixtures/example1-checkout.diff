@@ -0,0 +1,9 @@
+export function isValidTz(id: number): boolean {
+  const s = String(id);
+  if (s.length !== 9) return false;
+  let sum = 0;
+  for (let i = 0; i < 9; i++) {
+    sum += Number(s[i]) * ((i % 2) + 1);
+  }
+  return sum % 10 === 0;
+}
